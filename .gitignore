# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / 前端
node_modules/
frontend/dist/
*.tsbuildinfo

# 运行时数据（绝不入版本库）
data/
*.db
*.db-wal
*.db-shm
logs/
audit.log
uploads_tmp/
thumbs/
transcode/

# 配置与密钥（绝不入版本库）
.env
*.env
config.local.json
secrets.json
certs/

# 构建产物
build/
dist/
# ⚠️ 不要忽略 *.spec：PyInstaller 的 spec 文件是**手写的源码**
# （里面写着 hiddenimports、datas、excludes 等只有人才知道的决定），
# 不是构建输出。忽略它会导致换台机器再也打不出同样的包。
# 真正的构建产物是 build/ 与 dist/，上面已经排除。

# 编辑器与系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.part

# 本地测试用的模拟照片批次（人工构造的难例，不是项目资产）
模拟照片/

# 密钥与令牌绝不入库（2026-10-23 安全审计 ISSUE-030）
# `build/` 已整体忽略，但下面这几类曾出现在被手工拷来拷去的路径上，
# 单独写明是为了让"把临时文件放错地方"也不再泄露。
*.log
_askpass*
*_token*.txt
.env
.env.*
!.env.example

# 探针与变异脚本（2026-11-04 打包推送前补）
# 一次性验证脚本的命名惯例就是 `_probe_*` / `_mut_*`，它们常带真实令牌、
# 真实 IP、真实库路径；约定俗成放 build/，但被拷到根目录就漏了。
_probe_*
_mut_*

# 覆盖率与测试缓存
coverage/
.coverage
.coverage.*
htmlcov/
coverage.xml

# SQLite 附属文件与导入残留
*.sqlite
*.sqlite3
*.db-journal
*.orig
*.rej
*.bak

