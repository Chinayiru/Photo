{
  "name": "photobridge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PhotoBridge 手机端网页前端（一期：局域网直连）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --host",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.11",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
